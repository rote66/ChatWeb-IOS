mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-gemini-gecko-ios-arm64

ac_add_options --enable-application=mobile/ios
ac_add_options --target=aarch64-apple-ios
ac_add_options --enable-ios-target=13.0
ac_add_options --disable-webrtc
ac_add_options --disable-crashreporter
ac_add_options --disable-printing
ac_add_options --disable-webdriver
ac_add_options --disable-ctypes
# Graphite shaping is disabled for UIKit below, so do not generate its wasm2c
# sandbox. Keep RLBox isolation for every parser that remains reachable.
ac_add_options --with-wasm-sandboxed-libraries=ogg,expat,woff2
# Keep the Web Speech API and UIKit backend, but omit its test-only fake backend.
ac_add_options --disable-webspeechtestbackend
ac_add_options --disable-real-time-tracing
ac_add_options --disable-backgroundtasks
ac_add_options --disable-accessibility
ac_add_options --disable-ffmpeg
ac_add_options --disable-jxl
# Optimize the Gecko/native side for binary size. SpiderMonkey keeps its full
# JIT/Wasm feature set, but the iOS-specific js/moz.configure override uses
# -Oz instead of Firefox's usual -O3 for this size-constrained embedding.
ac_add_options --enable-optimize=-Oz
ac_add_options --enable-release
ac_add_options --enable-rust-simd
# Let the final XUL link see Rust and C/C++ bitcode together. This preserves the
# retained web platform while allowing LLVM to discard Rust C-ABI entry points
# that are not reachable from the UIKit Gecko embedding.
ac_add_options --enable-lto=cross,thin
ac_add_options --disable-debug
ac_add_options --disable-tests

# Rust-heavy Gecko components (Stylo, WebRender, wgpu, networking and glue)
# otherwise default to opt-level=2 even though C/C++ is built with -Oz.
# Keep the full feature set but optimize Rust code for binary size as well.
export RUSTC_OPT_LEVEL="z"

# Let the Mach-O linker discard unreferenced sections and merge functions with
# identical machine-code behavior after LTO. This is especially useful for the
# dedicated UIKit runtime because Firefox product surfaces are intentionally
# omitted while the core Gecko libraries remain large archives. Keep safe ICF;
# address-significant functions must remain distinct.
export LDFLAGS="-Wl,-dead_strip -Wl,-no_function_starts -Wl,--icf=safe -Wl,-mllvm,-enable-merge-functions"

# SpiderMonkey JIT is intentionally not disabled. Production readiness requires
# the iOS child process to report a working executable-memory/JIT path.

# Phase-1 Gemini does not require camera/microphone/WebRTC. The pinned Firefox
# 153 tree defines this switch in toolkit/moz.configure. The full WebRTC-enabled
# baseline was built and measured before changing this option.
