+
+void BrowsingContext::DidSet(FieldIndex<IDX_AppVersionOverride>) {
+  MOZ_ASSERT(IsTop());
+
+  PreOrderWalk([&](BrowsingContext* aContext) {
+    nsIDocShell* shell = aContext->GetDocShell();
+    if (shell) {
+      shell->ClearCachedAppVersion();
+    }
+  });
+}
