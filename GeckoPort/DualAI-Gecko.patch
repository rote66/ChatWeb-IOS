+NS_IMETHODIMP
+UIKitSpeechRecognitionService::Initialize(
+    WeakPtr<SpeechRecognition> aSpeechRecognition) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  mRecognition = new nsMainThreadPtrHolder<SpeechRecognition>(
+      "UIKitSpeechRecognitionService::mRecognition", aSpeechRecognition);
+  mState = MakeUnique<State>();
+  NSLog(@"[GeminiGecko][Speech] initialize");
+  return NS_OK;
+}
+
+void UIKitSpeechRecognitionService::EnsureRecognitionTaskOnMainThread() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mState || mState->mAborted || mState->mUnavailable ||
+      mState->mTaskStarted) {
+    return;
+  }
+
+  const SFSpeechRecognizerAuthorizationStatus authorization =
+      [SFSpeechRecognizer authorizationStatus];
+  if (authorization == SFSpeechRecognizerAuthorizationStatusNotDetermined) {
+    if (mState->mAuthorizationPending) {
+      return;
+    }
+    mState->mAuthorizationPending = true;
+    NSLog(@"[GeminiGecko][Speech] requesting speech authorization");
+    RefPtr<UIKitSpeechRecognitionService> self(this);
+    [SFSpeechRecognizer requestAuthorization:
+                            ^(SFSpeechRecognizerAuthorizationStatus status) {
+                              NS_DispatchToMainThread(NS_NewRunnableFunction(
+                                  "UIKitSpeechRecognitionService::Authorization",
+                                  [self, status] {
+                                    if (!self->mState) {
+                                      return;
+                                    }
+                                    self->mState->mAuthorizationPending = false;
+                                    NSLog(@"[GeminiGecko][Speech] authorization=%ld",
+                                          static_cast<long>(status));
+                                    self->EnsureRecognitionTaskOnMainThread();
+                                  }));
+                            }];
+    return;
+  }
+
+  if (authorization != SFSpeechRecognizerAuthorizationStatusAuthorized) {
+    mState->mUnavailable = true;
+    NSLog(@"[GeminiGecko][Speech] authorization denied/restricted=%ld",
+          static_cast<long>(authorization));
+    if (mRecognition) {
+      RefPtr<SpeechRecognition> recognition = mRecognition.get();
+      NS_DispatchToMainThread(NS_NewRunnableFunction(
+          "UIKitSpeechRecognitionService::AuthorizationDenied",
+          [recognition] {
+            recognition->DispatchError(
+                SpeechRecognition::EVENT_RECOGNITIONSERVICE_ERROR,
+                SpeechRecognitionErrorCode::Not_allowed,
+                "iOS speech recognition permission denied");
+          }));
+    }
+    return;
+  }
+
+  nsAutoString language;
+  if (mRecognition) {
+    mRecognition->GetLang(language);
+  }
+  NSString* localeIdentifier = nil;
+  if (!language.IsEmpty()) {
+    nsCString utf8 = NS_ConvertUTF16toUTF8(language);
+    localeIdentifier = [NSString stringWithUTF8String:utf8.get()];
+  }
+  if (!localeIdentifier || [localeIdentifier length] == 0) {
+    localeIdentifier = [[NSLocale preferredLanguages] firstObject];
+  }
+  NSLocale* locale = localeIdentifier
+                         ? [[[NSLocale alloc] initWithLocaleIdentifier:
+                                                     localeIdentifier] autorelease]
+                         : [NSLocale currentLocale];
+
+  mState->mRecognizer =
+      [[SFSpeechRecognizer alloc] initWithLocale:locale];
+  if (!mState->mRecognizer || !mState->mRecognizer.available) {
+    mState->mUnavailable = true;
+    NSLog(@"[GeminiGecko][Speech] recognizer unavailable locale=%@",
+          localeIdentifier);
+    if (mRecognition) {
+      mRecognition->DispatchError(
+          SpeechRecognition::EVENT_RECOGNITIONSERVICE_ERROR,
+          SpeechRecognitionErrorCode::Network,
+          "iOS speech recognizer is unavailable");
+    }
+    return;
+  }
+
+  mState->mRequest = [[SFSpeechAudioBufferRecognitionRequest alloc] init];
+  if (!mState->mRequest) {
+    mState->mUnavailable = true;
+    if (mRecognition) {
+      mRecognition->DispatchError(
+          SpeechRecognition::EVENT_RECOGNITIONSERVICE_ERROR,
+          SpeechRecognitionErrorCode::Audio_capture,
+          "Unable to create iOS speech audio request");
+    }
+    return;
+  }
+
+  mState->mRequest.shouldReportPartialResults =
+      mRecognition && mRecognition->InterimResults();
+  mState->mRequest.taskHint = SFSpeechRecognitionTaskHintDictation;
+
+  RefPtr<UIKitSpeechRecognitionService> self(this);
+  SFSpeechRecognitionTask* task =
+      [mState->mRecognizer
+          recognitionTaskWithRequest:mState->mRequest
+                       resultHandler:^(SFSpeechRecognitionResult* result,
+                                       NSError* error) {
+                         if (result) {
+                           nsString transcript =
+                               NSStringToUTF16(result.bestTranscription.formattedString);
+                           float confidence = 0.0f;
+                           SFTranscriptionSegment* lastSegment =
+                               [result.bestTranscription.segments lastObject];
+                           if (lastSegment) {
+                             confidence = lastSegment.confidence;
+                           }
+                           const bool isFinal = result.isFinal;
+                           NS_DispatchToMainThread(NS_NewRunnableFunction(
+                               "UIKitSpeechRecognitionService::Result",
+                               [self, transcript = std::move(transcript),
+                                confidence, isFinal]() mutable {
+                                 if (!self->mState ||
+                                     self->mState->mAborted ||
+                                     !self->mRecognition) {
+                                   return;
+                                 }
+
+                                 NSLog(@"[GeminiGecko][Speech] result final=%d chars=%zu",
+                                       isFinal ? 1 : 0,
+                                       static_cast<size_t>(transcript.Length()));
+
+                                 RefPtr<SpeechEvent> event = new SpeechEvent(
+                                     self->mRecognition,
+                                     isFinal
+                                         ? SpeechRecognition::
+                                               EVENT_RECOGNITIONSERVICE_FINAL_RESULT
+                                         : SpeechRecognition::
+                                               EVENT_RECOGNITIONSERVICE_INTERMEDIATE_RESULT);
+
+                                 RefPtr<SpeechRecognitionResultList> resultList =
+                                     new SpeechRecognitionResultList(
+                                         self->mRecognition);
+                                 RefPtr<SpeechRecognitionResult> speechResult =
+                                     new SpeechRecognitionResult(
+                                         self->mRecognition);
+                                 if (self->mRecognition->MaxAlternatives() > 0) {
+                                   RefPtr<SpeechRecognitionAlternative> alternative =
+                                       new SpeechRecognitionAlternative(
+                                           self->mRecognition);
+                                   alternative->mTranscript = transcript;
+                                   alternative->mConfidence = confidence;
+                                   speechResult->mItems.AppendElement(alternative);
+                                 }
+                                 resultList->mItems.AppendElement(speechResult);
+                                 event->mRecognitionResultList = resultList;
+                                 NS_DispatchToMainThread(event);
+
+                                 if (isFinal) {
+                                   self->CleanupOnMainThread(false);
+                                 }
+                               }));
+                         }
+
+                         if (error) {
+                           nsCString message = NSErrorMessage(error);
+                           NS_DispatchToMainThread(NS_NewRunnableFunction(
+                               "UIKitSpeechRecognitionService::Error",
+                               [self, message = std::move(message)]() mutable {
+                                 if (!self->mState ||
+                                     self->mState->mAborted ||
+                                     self->mState->mUnavailable) {
+                                   return;
+                                 }
+                                 NSLog(@"[GeminiGecko][Speech] error=%s",
+                                       message.get());
+                                 if (message.EqualsLiteral("No speech detected") &&
+                                     !self->mState->mFinishing &&
+                                     self->mState->mNoSpeechRetries < 3) {
+                                   self->mState->mNoSpeechRetries++;
+                                   NSLog(@"[GeminiGecko][Speech] retry no-speech attempt=%u",
+                                         self->mState->mNoSpeechRetries);
+                                   if (self->mState->mTask) {
+                                     [self->mState->mTask cancel];
+                                     [self->mState->mTask release];
+                                     self->mState->mTask = nil;
+                                   }
+                                   [self->mState->mRequest release];
+                                   self->mState->mRequest = nil;
+                                   [self->mState->mRecognizer release];
+                                   self->mState->mRecognizer = nil;
+                                   [self->mState->mAudioFormat release];
+                                   self->mState->mAudioFormat = nil;
+                                   self->mState->mAudioFormatRate = 0;
+                                   self->mState->mTaskStarted = false;
+                                   self->mState->mLoggedFirstAudio = false;
+                                   self->mState->mLoggedWaitingForSignal = false;
+                                   self->mState->mPendingAudio.clear();
+                                   return;
+                                 }
+                                 if (self->mRecognition) {
+                                   self->mRecognition->DispatchError(
+                                       SpeechRecognition::
+                                           EVENT_RECOGNITIONSERVICE_ERROR,
+                                       SpeechRecognitionErrorCode::Network,
+                                       message);
+                                 }
+                                 self->CleanupOnMainThread(false);
+                               }));
+                         }
+                       }];
+
+  if (!task) {
+    mState->mUnavailable = true;
+    NSLog(@"[GeminiGecko][Speech] failed to create recognition task");
+    if (mRecognition) {
+      mRecognition->DispatchError(
+          SpeechRecognition::EVENT_RECOGNITIONSERVICE_ERROR,
+          SpeechRecognitionErrorCode::Network,
+          "Unable to start iOS speech recognition task");
+    }
+    return;
+  }
+
+  mState->mTask = [task retain];
+  mState->mTaskStarted = true;
+  NSLog(@"[GeminiGecko][Speech] task started locale=%@ partial=%d",
+        localeIdentifier,
+        mState->mRequest.shouldReportPartialResults ? 1 : 0);
+
+  std::vector<PendingAudioChunk> pending =
+      std::move(mState->mPendingAudio);
+  mState->mPendingAudio.clear();
+  for (PendingAudioChunk& chunk : pending) {
+    AppendSamplesOnMainThread(std::move(chunk.mSamples), chunk.mSampleRate);
+  }
+  if (mState->mFinishing && mState->mRequest) {
+    [mState->mRequest endAudio];
+  }
+}
+
+NS_IMETHODIMP
+UIKitSpeechRecognitionService::ProcessAudioSegment(AudioSegment* aAudioSegment,
+                                                    int32_t aSampleRate) {
+  MOZ_ASSERT(!NS_IsMainThread());
+  if (!aAudioSegment || aAudioSegment->GetDuration() <= 0) {
+    return NS_OK;
+  }
+
+  nsTArray<int16_t> samples;
+  samples.SetCapacity(aAudioSegment->GetDuration());
+  for (AudioSegment::ConstChunkIterator iter(*aAudioSegment); !iter.IsEnded();
+       iter.Next()) {
+    const AudioChunk& chunk = *iter;
+    const uint32_t duration = static_cast<uint32_t>(chunk.GetDuration());
+    if (!duration) {
+      continue;
+    }
+    if (chunk.IsNull()) {
+      int16_t* out = samples.AppendElements(duration);
+      std::fill(out, out + duration, 0);
+      continue;
+    }
+
+    if (chunk.mBufferFormat == AUDIO_FORMAT_S16) {
+      const int16_t* source = chunk.ChannelData<int16_t>()[0];
+      samples.AppendElements(source, duration);
+    } else if (chunk.mBufferFormat == AUDIO_FORMAT_FLOAT32) {
+      const float* source = chunk.ChannelData<float>()[0];
+      int16_t* out = samples.AppendElements(duration);
+      for (uint32_t i = 0; i < duration; ++i) {
+        const float value = std::max(-1.0f, std::min(1.0f, source[i]));
+        out[i] = static_cast<int16_t>(std::lrintf(value * 32767.0f));
+      }
+    }
+  }
+
+  if (samples.IsEmpty()) {
+    return NS_OK;
+  }
+
+  RefPtr<UIKitSpeechRecognitionService> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "UIKitSpeechRecognitionService::AppendSamples",
+      [self, samples = std::move(samples), aSampleRate]() mutable {
+        self->AppendSamplesOnMainThread(std::move(samples), aSampleRate);
+      }));
+  return NS_OK;
+}
+
+void UIKitSpeechRecognitionService::AppendSamplesOnMainThread(
+    nsTArray<int16_t>&& aSamples, int32_t aSampleRate) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mState || mState->mAborted || mState->mUnavailable ||
+      aSamples.IsEmpty() || aSampleRate <= 0) {
+    return;
+  }
+
+  int32_t peak = 0;
+  double sumSquares = 0.0;
+  for (const int16_t sample : aSamples) {
+    const int32_t value = sample;
+    peak = std::max(peak, std::min(std::abs(value), 32767));
+    const double normalized = static_cast<double>(value) / 32768.0;
+    sumSquares += normalized * normalized;
+  }
+  mState->mLevelBufferCount++;
+  mState->mLevelFrameCount += aSamples.Length();
+  mState->mLevelPeak = std::max(mState->mLevelPeak, peak);
+  mState->mLevelSumSquares += sumSquares;
+  if (!mState->mLoggedFirstLevel || mState->mLevelBufferCount >= 25) {
+    const double rms = mState->mLevelFrameCount
+                           ? std::sqrt(mState->mLevelSumSquares /
+                                       mState->mLevelFrameCount)
+                           : 0.0;
+    NSLog(@"[GeminiGecko][Speech] input-level buffers=%u frames=%llu peak=%d rms=%.6f task=%d",
+          mState->mLevelBufferCount,
+          static_cast<unsigned long long>(mState->mLevelFrameCount),
+          mState->mLevelPeak, rms, mState->mTaskStarted ? 1 : 0);
+    mState->mLoggedFirstLevel = true;
+    mState->mLevelBufferCount = 0;
+    mState->mLevelFrameCount = 0;
+    mState->mLevelPeak = 0;
+    mState->mLevelSumSquares = 0.0;
+  }
+
+  if (!mState->mTaskStarted || !mState->mRequest) {
+    // Keep startup noise out of SFSpeechRecognizer. Build 57 measured the
+    // RemoteIO startup floor at peak=15; require a materially stronger signal
+    // before creating a recognition task so an initial silent task cannot end
+    // the whole DOM recognition session before the user has spoken.
+    if (peak < 512 && !mState->mAuthorizationPending) {
+      if (!mState->mLoggedWaitingForSignal) {
+        mState->mLoggedWaitingForSignal = true;
+        NSLog(@"[GeminiGecko][Speech] waiting for non-silent PCM peak=%d",
+              peak);
+      }
+      return;
+    }
+    // The system may still be displaying its one-time Speech permission
+    // prompt. Keep the short Web Speech capture window instead of discarding
+    // the first words the user speaks while authorization is pending.
+    PendingAudioChunk chunk;
+    chunk.mSamples = std::move(aSamples);
+    chunk.mSampleRate = aSampleRate;
+    mState->mPendingAudio.emplace_back(std::move(chunk));
+    mState->mLoggedWaitingForSignal = false;
+    EnsureRecognitionTaskOnMainThread();
+    return;
+  }
+
+  if (!mState->mAudioFormat || mState->mAudioFormatRate != aSampleRate) {
+    [mState->mAudioFormat release];
+    mState->mAudioFormat =
+        [[AVAudioFormat alloc] initStandardFormatWithSampleRate:aSampleRate
+                                                       channels:1];
+    mState->mAudioFormatRate = aSampleRate;
+  }
+  if (!mState->mAudioFormat) {
+    if (mRecognition) {
+      mRecognition->DispatchError(
+          SpeechRecognition::EVENT_RECOGNITIONSERVICE_ERROR,
+          SpeechRecognitionErrorCode::Audio_capture,
+          "Unable to create iOS speech PCM format");
+    }
+    return;
+  }
+
+  AVAudioPCMBuffer* buffer =
+      [[AVAudioPCMBuffer alloc] initWithPCMFormat:mState->mAudioFormat
+                                    frameCapacity:aSamples.Length()];
+  if (!buffer || !buffer.floatChannelData) {
+    [buffer release];
+    if (mRecognition) {
+      mRecognition->DispatchError(
+          SpeechRecognition::EVENT_RECOGNITIONSERVICE_ERROR,
+          SpeechRecognitionErrorCode::Audio_capture,
+          "Unable to allocate iOS speech PCM buffer");
+    }
+    return;
+  }
+
+  buffer.frameLength = aSamples.Length();
+  float* destination = buffer.floatChannelData[0];
+  for (uint32_t i = 0; i < aSamples.Length(); ++i) {
+    destination[i] = static_cast<float>(aSamples[i]) / 32768.0f;
+  }
+  [mState->mRequest appendAudioPCMBuffer:buffer];
+  [buffer release];
+
+  if (!mState->mLoggedFirstAudio) {
+    mState->mLoggedFirstAudio = true;
+    NSLog(@"[GeminiGecko][Speech] first audio frames=%zu rate=%d",
+          aSamples.Length(), aSampleRate);
+  }
+}
+
+NS_IMETHODIMP
+UIKitSpeechRecognitionService::SoundEnd() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mState || mState->mAborted || mState->mFinishing) {
+    return NS_OK;
+  }
+  mState->mFinishing = true;
+  NSLog(@"[GeminiGecko][Speech] sound end");
+  if (mState->mRequest) {
+    [mState->mRequest endAudio];
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+UIKitSpeechRecognitionService::ValidateAndSetGrammarList(
+    SpeechGrammar* aSpeechGrammar,
+    nsISpeechGrammarCompilationCallback* aCallback) {
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+UIKitSpeechRecognitionService::Abort() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mState || mState->mAborted) {
+    return NS_OK;
+  }
+  mState->mAborted = true;
+  NSLog(@"[GeminiGecko][Speech] abort");
+  CleanupOnMainThread(true);
+  return NS_OK;
+}
+
+void UIKitSpeechRecognitionService::CleanupOnMainThread(bool aCancelTask) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mState) {
+    return;
+  }
+  if (mState->mTask) {
+    if (aCancelTask) {
+      [mState->mTask cancel];
+    }
+    [mState->mTask release];
+    mState->mTask = nil;
+  }
+  [mState->mRequest release];
+  mState->mRequest = nil;
+  [mState->mRecognizer release];
+  mState->mRecognizer = nil;
+  [mState->mAudioFormat release];
+  mState->mAudioFormat = nil;
+  mState->mAudioFormatRate = 0;
+  mState->mTaskStarted = false;
+  mState->mUnavailable = true;
+  mState->mPendingAudio.clear();
+}
+
+}  // namespace mozilla
