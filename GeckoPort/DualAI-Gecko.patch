diff --git a/build/moz.configure/toolchain.configure b/build/moz.configure/toolchain.configure
index 793924355917c7ca4319f9ac3ff35948aa174655..07023ba4f1c7fc0ccf8419aa223fe08a644efdae 100644
--- a/build/moz.configure/toolchain.configure
+++ b/build/moz.configure/toolchain.configure
@@ -2875,13 +2875,21 @@ set_config("MOZ_CETCOMPAT_LDFLAGS", cet_ldflags)
 
 # Frame pointers
 # ==============================================================
-@depends(c_compiler)
-def frame_pointer_flags(compiler):
+@depends(c_compiler, target)
+def frame_pointer_flags(compiler, target):
     if compiler.type == "clang-cl":
         return namespace(
             enable=["-Oy-"],
             disable=["-Oy"],
         )
+    if target.os == "iOS":
+        # The dedicated UIKit embedding is built with C++ exceptions disabled
+        # and Rust panic=abort.  Do not retain several MiB of unwind metadata
+        # solely for profiler/crash backtraces in the release XUL.
+        return namespace(
+            enable=["-fno-omit-frame-pointer", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables"],
+            disable=["-fomit-frame-pointer", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables"],
+        )
     return namespace(
         enable=["-fno-omit-frame-pointer", "-funwind-tables"],
         disable=["-fomit-frame-pointer", "-funwind-tables"],
