+void nsFilePicker::InitNative(nsIWidget* aParent, const nsAString& aTitle) {
+  mParentWidget = aParent;
+  mTitle = aTitle;
+}
+
+NS_IMETHODIMP nsFilePicker::Open(nsIFilePickerShownCallback* aCallback) {
+  if (MaybeBlockFilePicker(aCallback)) {
+    return NS_OK;
+  }
+
+  RefPtr<nsFilePicker> self = this;
+  nsCOMPtr<nsIFilePickerShownCallback> callback = aCallback;
+  return NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "UIKitFilePicker::Open", [self, callback]() {
+        if (self->mMode != nsIFilePicker::modeOpen &&
+            self->mMode != nsIFilePicker::modeOpenMultiple) {
+          NSLog(@"[GeminiGecko][FilePicker] unsupported mode=%d",
+                int(self->mMode));
+          if (callback) {
+            callback->Done(nsIFilePicker::returnCancel);
+          }
+          return;
+        }
+
+        UIViewController* presenter = TopViewController();
+        if (!presenter) {
+          NSLog(@"[GeminiGecko][FilePicker] no presenter");
+          if (callback) {
+            callback->Done(nsIFilePicker::returnCancel);
+          }
+          return;
+        }
+
+        bool wantsPhotoLibrary = false;
+        for (const nsString& filter : self->mFilters) {
+          if (filter.Find(u"image/"_ns) != kNotFound ||
+              filter.Find(u"*.jpg"_ns) != kNotFound ||
+              filter.Find(u"*.jpeg"_ns) != kNotFound ||
+              filter.Find(u"*.png"_ns) != kNotFound ||
+              filter.Find(u"*.heic"_ns) != kNotFound ||
+              filter.Find(u"*.webp"_ns) != kNotFound) {
+            wantsPhotoLibrary = true;
+            break;
+          }
+        }
+
+        if (wantsPhotoLibrary) {
+          UIImagePickerController* picker = [[UIImagePickerController alloc] init];
+          picker.sourceType = UIImagePickerControllerSourceTypePhotoLibrary;
+          picker.allowsEditing = NO;
+
+          GeckoUIKitPhotoPickerDelegate* delegate =
+              [[GeckoUIKitPhotoPickerDelegate alloc] initWithFilePicker:self
+                                                                callback:callback];
+          picker.delegate = delegate;
+          objc_setAssociatedObject(
+              picker,
+              @selector(imagePickerController:didFinishPickingMediaWithInfo:),
+              delegate, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+          [delegate release];
+
+          NSLog(@"[GeminiGecko][PhotoPicker] present filters=%lu",
+                (unsigned long)self->mFilters.Length());
+          [presenter presentViewController:picker animated:YES completion:nil];
+          [picker release];
+          return;
+        }
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+        UIDocumentPickerViewController* picker =
+            [[UIDocumentPickerViewController alloc]
+                initWithDocumentTypes:@[ @"public.item" ]
+                               inMode:UIDocumentPickerModeImport];
+#pragma clang diagnostic pop
+        picker.allowsMultipleSelection =
+            self->mMode == nsIFilePicker::modeOpenMultiple;
+
+        GeckoUIKitFilePickerDelegate* delegate =
+            [[GeckoUIKitFilePickerDelegate alloc] initWithFilePicker:self
+                                                            callback:callback];
+        picker.delegate = delegate;
+        objc_setAssociatedObject(picker, @selector(documentPicker:didPickDocumentsAtURLs:),
+                                 delegate, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        [delegate release];
+
+        NSLog(@"[GeminiGecko][FilePicker] present multiple=%d",
+              picker.allowsMultipleSelection ? 1 : 0);
+        [presenter presentViewController:picker animated:YES completion:nil];
+        [picker release];
+      }));
+}
+
+void nsFilePicker::SetSelectedPaths(const nsTArray<nsString>& aPaths) {
+  mFiles.Clear();
+  for (const nsString& path : aPaths) {
+    nsCOMPtr<nsIFile> file;
+    if (NS_SUCCEEDED(NS_NewLocalFile(path, getter_AddRefs(file))) && file) {
+      mFiles.AppendObject(file);
+    }
+  }
+}
+
+NS_IMETHODIMP nsFilePicker::GetFile(nsIFile** aFile) {
+  NS_ENSURE_ARG_POINTER(aFile);
+  *aFile = nullptr;
+  if (mFiles.Count() > 0) {
+    NS_ADDREF(*aFile = mFiles.ObjectAt(0));
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetFileURL(nsIURI** aFileURL) {
+  NS_ENSURE_ARG_POINTER(aFileURL);
+  *aFileURL = nullptr;
+  return mFiles.Count() > 0 ? NS_NewFileURI(aFileURL, mFiles.ObjectAt(0))
+                            : NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetFiles(nsISimpleEnumerator** aFiles) {
+  return NS_NewArrayEnumerator(aFiles, mFiles, NS_GET_IID(nsIFile));
+}
+
+NS_IMETHODIMP nsFilePicker::SetDefaultString(const nsAString& aString) {
+  mDefaultFilename = aString;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetDefaultString(nsAString& aString) {
+  aString = mDefaultFilename;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::SetDefaultExtension(const nsAString& aExtension) {
+  mDefaultExtension = aExtension;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetDefaultExtension(nsAString& aExtension) {
+  aExtension = mDefaultExtension;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::AppendFilter(const nsAString& aTitle,
+                                         const nsAString& aFilter) {
+  mFilters.AppendElement(aFilter);
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetFilterIndex(int32_t* aFilterIndex) {
+  NS_ENSURE_ARG_POINTER(aFilterIndex);
+  *aFilterIndex = mFilterIndex;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::SetFilterIndex(int32_t aFilterIndex) {
+  mFilterIndex = aFilterIndex;
+  return NS_OK;
+}
