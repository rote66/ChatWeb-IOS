+NS_IMPL_ISUPPORTS(UIKitSpeechRecognitionService, nsISpeechRecognitionService)
+
+UIKitSpeechRecognitionService::UIKitSpeechRecognitionService() = default;
+UIKitSpeechRecognitionService::~UIKitSpeechRecognitionService() = default;
