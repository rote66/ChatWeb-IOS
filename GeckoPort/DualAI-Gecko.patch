+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_dom_UIKitSpeechRecognitionService_h
+#define mozilla_dom_UIKitSpeechRecognitionService_h
+
+#include "mozilla/UniquePtr.h"
+#include "nsISpeechRecognitionService.h"
+#include "nsProxyRelease.h"
+#include "nsTArray.h"
+
+namespace mozilla {
+
+namespace dom {
+class SpeechRecognition;
+}
+
+// iOS implementation of the Web Speech recognition service. Gecko remains
+// responsible for permission-gated microphone capture and speech endpointing;
+// this class feeds the resulting mono PCM to the system Speech framework and
+// converts SFSpeechRecognizer results back into Gecko SpeechEvents.
+class UIKitSpeechRecognitionService final
+    : public nsISpeechRecognitionService {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+  NS_DECL_NSISPEECHRECOGNITIONSERVICE
+
+  UIKitSpeechRecognitionService();
+
+ private:
+  ~UIKitSpeechRecognitionService();
+
+  struct State;
+  UniquePtr<State> mState;
+  nsMainThreadPtrHandle<dom::SpeechRecognition> mRecognition;
+
+  void EnsureRecognitionTaskOnMainThread();
+  void AppendSamplesOnMainThread(nsTArray<int16_t>&& aSamples,
+                                 int32_t aSampleRate);
+  void CleanupOnMainThread(bool aCancelTask);
+};
+
+}  // namespace mozilla
+
+#endif  // mozilla_dom_UIKitSpeechRecognitionService_h
