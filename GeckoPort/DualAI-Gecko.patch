+void BrowsingContext::DidSet(FieldIndex<IDX_OscpuOverride>) {
+  MOZ_ASSERT(IsTop());
+
+  PreOrderWalk([&](BrowsingContext* aContext) {
+    nsIDocShell* shell = aContext->GetDocShell();
+    if (shell) {
+      shell->ClearCachedOscpu();
+    }
+  });
+}
