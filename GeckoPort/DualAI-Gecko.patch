+@interface GeckoUIKitPhotoPickerDelegate
+    : NSObject <UIImagePickerControllerDelegate, UINavigationControllerDelegate> {
+ @private
+  RefPtr<nsFilePicker> mFilePicker;
+  nsCOMPtr<nsIFilePickerShownCallback> mCallback;
+}
+- (instancetype)initWithFilePicker:(nsFilePicker*)aFilePicker
+                           callback:(nsIFilePickerShownCallback*)aCallback;
+@end
+
+@implementation GeckoUIKitPhotoPickerDelegate
+
+- (instancetype)initWithFilePicker:(nsFilePicker*)aFilePicker
+                           callback:(nsIFilePickerShownCallback*)aCallback {
+  self = [super init];
+  if (self) {
+    mFilePicker = aFilePicker;
+    mCallback = aCallback;
+  }
+  return self;
+}
+
+- (void)imagePickerController:(UIImagePickerController*)picker
+    didFinishPickingMediaWithInfo:(NSDictionary<UIImagePickerControllerInfoKey, id>*)info {
+  NSString* destination = nil;
+  NSURL* sourceURL = info[UIImagePickerControllerImageURL];
+  NSString* extension = sourceURL.pathExtension.lowercaseString;
+  if (!extension.length) {
+    extension = @"jpg";
+  }
+  destination = [NSTemporaryDirectory()
+      stringByAppendingPathComponent:[NSString
+          stringWithFormat:@"GeminiPhoto-%@.%@", NSUUID.UUID.UUIDString,
+                           extension]];
+
+  NSError* copyError = nil;
+  BOOL wroteFile = NO;
+  if (sourceURL.isFileURL) {
+    NSURL* destinationURL = [NSURL fileURLWithPath:destination];
+    wroteFile = [NSFileManager.defaultManager copyItemAtURL:sourceURL
+                                                      toURL:destinationURL
+                                                      error:&copyError];
+  }
+
+  if (!wroteFile) {
+    UIImage* image = info[UIImagePickerControllerOriginalImage];
+    NSData* data = image ? UIImageJPEGRepresentation(image, 0.95) : nil;
+    wroteFile = data && [data writeToFile:destination atomically:YES];
+  }
+
+  nsTArray<nsString> paths;
+  if (wroteFile && destination.length) {
+    nsAutoString geckoPath;
+    CopyUTF8toUTF16(nsDependentCString(destination.UTF8String), geckoPath);
+    paths.AppendElement(std::move(geckoPath));
+  }
+
+  if (mFilePicker) {
+    mFilePicker->SetSelectedPaths(paths);
+  }
+  NSLog(@"[GeminiGecko][PhotoPicker] selected count=%lu source=%@ copyError=%@",
+        (unsigned long)paths.Length(), sourceURL, copyError);
+
+  nsCOMPtr<nsIFilePickerShownCallback> callback = mCallback.forget();
+  mFilePicker = nullptr;
+  [picker dismissViewControllerAnimated:YES completion:nil];
+  if (callback) {
+    callback->Done(paths.IsEmpty() ? nsIFilePicker::returnCancel
+                                   : nsIFilePicker::returnOK);
+  }
+}
+
+- (void)imagePickerControllerDidCancel:(UIImagePickerController*)picker {
+  NSLog(@"[GeminiGecko][PhotoPicker] cancelled");
+  nsCOMPtr<nsIFilePickerShownCallback> callback = mCallback.forget();
+  mFilePicker = nullptr;
+  [picker dismissViewControllerAnimated:YES completion:nil];
+  if (callback) {
+    callback->Done(nsIFilePicker::returnCancel);
+  }
+}
+
+@end
+
+@implementation GeckoUIKitFilePickerDelegate
+
+- (instancetype)initWithFilePicker:(nsFilePicker*)aFilePicker
+                           callback:(nsIFilePickerShownCallback*)aCallback {
+  self = [super init];
+  if (self) {
+    mFilePicker = aFilePicker;
+    mCallback = aCallback;
+  }
+  return self;
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController*)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL*>*)urls {
+  nsTArray<nsString> paths;
+  for (NSURL* url in urls) {
+    NSString* path = url.path;
+    if (!path.length) {
+      continue;
+    }
+    nsAutoString geckoPath;
+    CopyUTF8toUTF16(nsDependentCString(path.UTF8String), geckoPath);
+    paths.AppendElement(std::move(geckoPath));
+  }
+
+  if (mFilePicker) {
+    mFilePicker->SetSelectedPaths(paths);
+  }
+  NSLog(@"[GeminiGecko][FilePicker] selected count=%lu",
+        (unsigned long)paths.Length());
+
+  nsCOMPtr<nsIFilePickerShownCallback> callback = mCallback.forget();
+  mFilePicker = nullptr;
+  if (callback) {
+    callback->Done(paths.IsEmpty() ? nsIFilePicker::returnCancel
+                                   : nsIFilePicker::returnOK);
+  }
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController*)controller {
+  NSLog(@"[GeminiGecko][FilePicker] cancelled");
+  nsCOMPtr<nsIFilePickerShownCallback> callback = mCallback.forget();
+  mFilePicker = nullptr;
+  if (callback) {
+    callback->Done(nsIFilePicker::returnCancel);
+  }
+}
+
+@end
+
