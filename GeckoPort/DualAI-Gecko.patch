+  nsTArray<int16_t> mSamples;
+  int32_t mSampleRate = 0;
+};
+
+static nsString NSStringToUTF16(NSString* aString) {
+  if (!aString) {
+    return nsString();
+  }
+  const char* utf8 = [aString UTF8String];
+  return NS_ConvertUTF8toUTF16(utf8 ? utf8 : "");
+}
+
+static nsCString NSErrorMessage(NSError* aError) {
+  if (!aError) {
+    return "Speech recognition failed"_ns;
+  }
+  const char* utf8 = [[aError localizedDescription] UTF8String];
+  return nsCString(utf8 ? utf8 : "Speech recognition failed");
+}
+
+}  // namespace
+
+struct UIKitSpeechRecognitionService::State {
+  SFSpeechRecognizer* mRecognizer = nil;
+  SFSpeechAudioBufferRecognitionRequest* mRequest = nil;
+  SFSpeechRecognitionTask* mTask = nil;
+  AVAudioFormat* mAudioFormat = nil;
+  int32_t mAudioFormatRate = 0;
+  bool mAuthorizationPending = false;
+  bool mTaskStarted = false;
+  bool mUnavailable = false;
+  bool mAborted = false;
+  bool mFinishing = false;
+  bool mLoggedFirstAudio = false;
+  uint32_t mLevelBufferCount = 0;
+  uint64_t mLevelFrameCount = 0;
+  int32_t mLevelPeak = 0;
+  double mLevelSumSquares = 0.0;
+  bool mLoggedFirstLevel = false;
+  bool mLoggedWaitingForSignal = false;
+  uint32_t mNoSpeechRetries = 0;
+  std::vector<PendingAudioChunk> mPendingAudio;
+
+  ~State() {
+    if (mTask) {
+      [mTask cancel];
+      [mTask release];
+      mTask = nil;
+    }
+    [mRequest release];
+    mRequest = nil;
+    [mRecognizer release];
+    mRecognizer = nil;
+    [mAudioFormat release];
+    mAudioFormat = nil;
+  }
+};
