+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#import <AVFoundation/AVFoundation.h>
+#import <AudioToolbox/AudioToolbox.h>
+#import <AudioUnit/AudioUnit.h>
+#import <os/lock.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <unistd.h>
+#include <vector>
+
+#include "UIKitAudioCapture.h"
+
+namespace mozilla::widget {
+
+static os_unfair_lock sCaptureLock = OS_UNFAIR_LOCK_INIT;
+static void* sCaptureContext = nullptr;
+static UIKitAudioCaptureCallback sCaptureCallback = nullptr;
+static AudioUnit sRemoteIO = nullptr;
+static BOOL sStopping = NO;
+static std::atomic<uint32_t> sCallbacksInFlight{0};
+static BOOL sLoggedFirstBuffer = NO;
+static BOOL sLoggedRenderError = NO;
+static uint32_t sLevelBufferCount = 0;
+static uint64_t sLevelFrameCount = 0;
+static int32_t sLevelPeak = 0;
+static double sLevelSumSquares = 0.0;
+static constexpr uint32_t kCaptureSampleRate = 48000;
+static constexpr uint32_t kRemoteIORetryLimit = 5;
+static constexpr int64_t kRemoteIORetryDelayNs = 120 * NSEC_PER_MSEC;
+
+static bool IsCurrentCapture(void* aContext) {
+  os_unfair_lock_lock(&sCaptureLock);
+  const bool current = sCaptureContext == aContext && sCaptureCallback;
+  os_unfair_lock_unlock(&sCaptureLock);
+  return current;
+}
+
+static void LogBufferLevel(const int16_t* aSamples, uint32_t aFrames,
+                           uint32_t aRate) {
+  if (!aSamples || !aFrames) {
+    return;
+  }
+  double sumSquares = 0.0;
+  int32_t peak = 0;
+  for (uint32_t i = 0; i < aFrames; ++i) {
+    const int32_t sample = aSamples[i];
+    peak = std::max(peak, std::min(std::abs(sample), 32767));
+    const double normalized = static_cast<double>(sample) / 32768.0;
+    sumSquares += normalized * normalized;
+  }
+  const double rms = std::sqrt(sumSquares / aFrames);
+  if (!sLoggedFirstBuffer) {
+    sLoggedFirstBuffer = YES;
+    NSLog(@"[GeminiGecko][Mic] first-buffer frames=%u rate=%u peak=%d rms=%.6f",
+          aFrames, aRate, peak, rms);
+  }
+
+  sLevelBufferCount++;
+  sLevelFrameCount += aFrames;
+  sLevelPeak = std::max(sLevelPeak, peak);
+  sLevelSumSquares += sumSquares;
+  if (sLevelBufferCount >= 24) {
+    const double windowRms =
+        sLevelFrameCount ? std::sqrt(sLevelSumSquares / sLevelFrameCount) : 0.0;
+    NSLog(@"[GeminiGecko][Mic] level buffers=%u frames=%llu peak=%d rms=%.6f",
+          sLevelBufferCount, static_cast<unsigned long long>(sLevelFrameCount),
+          sLevelPeak, windowRms);
+    sLevelBufferCount = 0;
+    sLevelFrameCount = 0;
+    sLevelPeak = 0;
+    sLevelSumSquares = 0.0;
+  }
+}
+
+static OSStatus RemoteIOInputCallback(void* aUserData,
+                                      AudioUnitRenderActionFlags* aFlags,
+                                      const AudioTimeStamp* aTimeStamp,
+                                      UInt32 aBusNumber,
+                                      UInt32 aFrameCount,
+                                      AudioBufferList* aData) {
+  AudioUnit unit = nullptr;
+  UIKitAudioCaptureCallback callback = nullptr;
+  void* context = nullptr;
+  bool active = false;
+  os_unfair_lock_lock(&sCaptureLock);
+  if (sRemoteIO && !sStopping && sCaptureContext == aUserData &&
+      sCaptureCallback) {
+    unit = sRemoteIO;
+    callback = sCaptureCallback;
+    context = sCaptureContext;
+    sCallbacksInFlight.fetch_add(1, std::memory_order_acq_rel);
+    active = true;
+  }
+  os_unfair_lock_unlock(&sCaptureLock);
+  if (!unit || !callback || !aFrameCount) {
+    return noErr;
+  }
+
+  struct AutoCallbackActivity final {
+    bool mActive;
+    ~AutoCallbackActivity() {
+      if (mActive) {
+        sCallbacksInFlight.fetch_sub(1, std::memory_order_acq_rel);
+      }
+    }
+  } activity{active};
+
+  thread_local std::vector<int16_t> samples;
+  samples.resize(aFrameCount);
+  AudioBufferList buffers = {};
+  buffers.mNumberBuffers = 1;
+  buffers.mBuffers[0].mNumberChannels = 1;
+  buffers.mBuffers[0].mDataByteSize =
+      aFrameCount * static_cast<UInt32>(sizeof(int16_t));
+  buffers.mBuffers[0].mData = samples.data();
+
+  OSStatus status =
+      AudioUnitRender(unit, aFlags, aTimeStamp, 1, aFrameCount, &buffers);
+  if (status != noErr) {
+    if (!sLoggedRenderError) {
+      sLoggedRenderError = YES;
+      NSLog(@"[GeminiGecko][Mic] AudioUnitRender failed status=%d",
+            static_cast<int>(status));
+    }
+    return status;
+  }
+
+  const uint32_t frames = static_cast<uint32_t>(
+      buffers.mBuffers[0].mDataByteSize / sizeof(int16_t));
+  if (frames) {
+    LogBufferLevel(samples.data(), frames, kCaptureSampleRate);
+    callback(context, samples.data(), frames, kCaptureSampleRate);
+  }
+  return noErr;
+}
+
+static void StopRemoteIOOnMainThread() {
+  AudioUnit unit = nullptr;
+  os_unfair_lock_lock(&sCaptureLock);
+  unit = sRemoteIO;
+  if (unit) {
+    // Prevent any new callback from entering AudioUnitRender before the unit is
+    // stopped. A callback that already copied sRemoteIO is tracked below and
+    // must leave AudioUnitRender before teardown proceeds.
+    sStopping = YES;
+  }
+  os_unfair_lock_unlock(&sCaptureLock);
+  if (!unit) {
+    return;
+  }
+
+  uint32_t waits = 0;
+  while (sCallbacksInFlight.load(std::memory_order_acquire) != 0) {
+    if (++waits == 20) {
+      NSLog(@"[GeminiGecko][Mic] waiting for capture callback drain inflight=%u",
+            sCallbacksInFlight.load(std::memory_order_relaxed));
+    }
+    usleep(1000);
+  }
+
+  const OSStatus stopStatus = AudioOutputUnitStop(unit);
+  NSLog(@"[GeminiGecko][Mic] RemoteIO stop synchronized status=%d waits=%u",
+        static_cast<int>(stopStatus), waits);
+
+  os_unfair_lock_lock(&sCaptureLock);
+  if (sRemoteIO == unit) {
+    sRemoteIO = nullptr;
+  }
+  os_unfair_lock_unlock(&sCaptureLock);
+
+  AudioUnitUninitialize(unit);
+  AudioComponentInstanceDispose(unit);
+
+  os_unfair_lock_lock(&sCaptureLock);
+  sStopping = NO;
+  os_unfair_lock_unlock(&sCaptureLock);
+  NSLog(@"[GeminiGecko][Mic] RemoteIO stopped");
+}
+
+static void StartRemoteIOOnMainThread(void* aContext, uint32_t aAttempt = 0,
+                                      bool aConfigureSession = true) {
+  if (!IsCurrentCapture(aContext)) {
+    return;
+  }
+
+  StopRemoteIOOnMainThread();
+
+  AVAudioSession* session = AVAudioSession.sharedInstance;
+  if (aConfigureSession) {
+    NSError* sessionError = nil;
+    if (![session setCategory:AVAudioSessionCategoryPlayAndRecord
+                          mode:AVAudioSessionModeMeasurement
+                       options:AVAudioSessionCategoryOptionDefaultToSpeaker
+                         error:&sessionError]) {
+      NSLog(@"[GeminiGecko][Mic] setCategory failed error=%@", sessionError);
+      return;
+    }
+    AVAudioSessionPortDescription* preferredInput = nil;
+    for (AVAudioSessionPortDescription* input in session.availableInputs) {
+      if ([input.portType isEqualToString:AVAudioSessionPortBuiltInMic]) {
+        preferredInput = input;
+        break;
+      }
+    }
+    if (preferredInput) {
+      sessionError = nil;
+      if (![session setPreferredInput:preferredInput error:&sessionError]) {
+        NSLog(@"[GeminiGecko][Mic] setPreferredInput failed error=%@",
+              sessionError);
+      }
+    } else {
+      NSLog(@"[GeminiGecko][Mic] built-in microphone not listed available=%@",
+            session.availableInputs);
+    }
+    sessionError = nil;
+    if (![session setPreferredSampleRate:kCaptureSampleRate error:&sessionError]) {
+      NSLog(@"[GeminiGecko][Mic] setPreferredSampleRate failed error=%@",
+            sessionError);
+    }
+    sessionError = nil;
+    if (![session setPreferredIOBufferDuration:0.02 error:&sessionError]) {
+      NSLog(@"[GeminiGecko][Mic] setPreferredIOBufferDuration failed error=%@",
+            sessionError);
+    }
+    sessionError = nil;
+    if (![session setActive:YES error:&sessionError]) {
+      NSLog(@"[GeminiGecko][Mic] setActive failed error=%@", sessionError);
+      return;
+    }
+  }
+
+  NSLog(@"[GeminiGecko][Mic] session active attempt=%u category=%@ mode=%@ rate=%.0f preferredInput=%@ inputs=%@ outputs=%@",
+        aAttempt, session.category, session.mode, session.sampleRate,
+        session.preferredInput, session.currentRoute.inputs,
+        session.currentRoute.outputs);
+
+  AudioComponentDescription description = {};
+  description.componentType = kAudioUnitType_Output;
+  description.componentSubType = kAudioUnitSubType_RemoteIO;
+  description.componentManufacturer = kAudioUnitManufacturer_Apple;
+  AudioComponent component = AudioComponentFindNext(nullptr, &description);
+  if (!component) {
+    NSLog(@"[GeminiGecko][Mic] RemoteIO component not found");
+    return;
+  }
+
+  AudioUnit unit = nullptr;
+  OSStatus status = AudioComponentInstanceNew(component, &unit);
+  if (status != noErr || !unit) {
+    NSLog(@"[GeminiGecko][Mic] RemoteIO instance failed status=%d",
+          static_cast<int>(status));
+    return;
+  }
+
+  UInt32 enable = 1;
+  status = AudioUnitSetProperty(unit, kAudioOutputUnitProperty_EnableIO,
+                                kAudioUnitScope_Input, 1, &enable,
+                                sizeof(enable));
+  if (status != noErr) {
+    NSLog(@"[GeminiGecko][Mic] enable input bus failed status=%d",
+          static_cast<int>(status));
+    AudioComponentInstanceDispose(unit);
+    return;
+  }
+
+  UInt32 disable = 0;
+  status = AudioUnitSetProperty(unit, kAudioOutputUnitProperty_EnableIO,
+                                kAudioUnitScope_Output, 0, &disable,
+                                sizeof(disable));
+  if (status != noErr) {
+    NSLog(@"[GeminiGecko][Mic] disable output bus failed status=%d",
+          static_cast<int>(status));
+    AudioComponentInstanceDispose(unit);
+    return;
+  }
+
+  AudioStreamBasicDescription hardwareFormat = {};
+  UInt32 hardwareFormatSize = sizeof(hardwareFormat);
+  status = AudioUnitGetProperty(unit, kAudioUnitProperty_StreamFormat,
+                                kAudioUnitScope_Input, 1, &hardwareFormat,
+                                &hardwareFormatSize);
+  NSLog(@"[GeminiGecko][Mic] RemoteIO hardware status=%d rate=%.0f channels=%u",
+        static_cast<int>(status), hardwareFormat.mSampleRate,
+        hardwareFormat.mChannelsPerFrame);
+
+  AudioStreamBasicDescription format = {};
+  format.mSampleRate = kCaptureSampleRate;
+  format.mFormatID = kAudioFormatLinearPCM;
+  format.mFormatFlags =
+      kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked;
+  format.mBytesPerPacket = sizeof(int16_t);
+  format.mFramesPerPacket = 1;
+  format.mBytesPerFrame = sizeof(int16_t);
+  format.mChannelsPerFrame = 1;
+  format.mBitsPerChannel = 16;
+
+  status = AudioUnitSetProperty(unit, kAudioUnitProperty_StreamFormat,
+                                kAudioUnitScope_Output, 1, &format,
+                                sizeof(format));
+  if (status != noErr) {
+    NSLog(@"[GeminiGecko][Mic] set input client format failed status=%d",
+          static_cast<int>(status));
+    AudioComponentInstanceDispose(unit);
+    return;
+  }
+
+  AURenderCallbackStruct callback = {};
+  callback.inputProc = RemoteIOInputCallback;
+  callback.inputProcRefCon = aContext;
+  status = AudioUnitSetProperty(unit, kAudioOutputUnitProperty_SetInputCallback,
+                                kAudioUnitScope_Global, 1, &callback,
+                                sizeof(callback));
+  if (status != noErr) {
+    NSLog(@"[GeminiGecko][Mic] set input callback failed status=%d",
+          static_cast<int>(status));
+    AudioComponentInstanceDispose(unit);
+    return;
+  }
+
+  status = AudioUnitInitialize(unit);
+  if (status != noErr) {
+    NSLog(@"[GeminiGecko][Mic] RemoteIO initialize failed status=%d",
+          static_cast<int>(status));
+    AudioComponentInstanceDispose(unit);
+    if (status == kAudioUnitErr_InvalidPropertyValue &&
+        aAttempt < kRemoteIORetryLimit && IsCurrentCapture(aContext)) {
+      const uint32_t nextAttempt = aAttempt + 1;
+      NSLog(@"[GeminiGecko][Mic] RemoteIO retry scheduled attempt=%u",
+            nextAttempt);
+      dispatch_after(dispatch_time(DISPATCH_TIME_NOW, kRemoteIORetryDelayNs),
+                     dispatch_get_main_queue(), ^{
+                       if (IsCurrentCapture(aContext)) {
+                         StartRemoteIOOnMainThread(aContext, nextAttempt, false);
+                       }
+                     });
+    }
+    return;
+  }
+
+  os_unfair_lock_lock(&sCaptureLock);
+  const bool stillCurrent =
+      sCaptureContext == aContext && sCaptureCallback && !sRemoteIO;
+  if (stillCurrent) {
+    sRemoteIO = unit;
+  }
+  os_unfair_lock_unlock(&sCaptureLock);
+  if (!stillCurrent) {
+    AudioUnitUninitialize(unit);
+    AudioComponentInstanceDispose(unit);
+    return;
+  }
+
+  status = AudioOutputUnitStart(unit);
+  if (status != noErr) {
+    NSLog(@"[GeminiGecko][Mic] RemoteIO start failed status=%d",
+          static_cast<int>(status));
+    os_unfair_lock_lock(&sCaptureLock);
+    if (sRemoteIO == unit) {
+      sRemoteIO = nullptr;
+    }
+    os_unfair_lock_unlock(&sCaptureLock);
+    AudioUnitUninitialize(unit);
+    AudioComponentInstanceDispose(unit);
+    if (status == kAudioUnitErr_InvalidPropertyValue &&
+        aAttempt < kRemoteIORetryLimit && IsCurrentCapture(aContext)) {
+      const uint32_t nextAttempt = aAttempt + 1;
+      NSLog(@"[GeminiGecko][Mic] RemoteIO start retry scheduled attempt=%u",
+            nextAttempt);
+      dispatch_after(dispatch_time(DISPATCH_TIME_NOW, kRemoteIORetryDelayNs),
+                     dispatch_get_main_queue(), ^{
+                       if (IsCurrentCapture(aContext)) {
+                         StartRemoteIOOnMainThread(aContext, nextAttempt, false);
+                       }
+                     });
+    }
+    return;
+  }
+
+  NSLog(@"[GeminiGecko][Mic] RemoteIO started attempt=%u rate=%u channels=1",
+        aAttempt, kCaptureSampleRate);
+}
+
+bool StartUIKitAudioCapture(void* aContext,
+                            UIKitAudioCaptureCallback aCallback) {
+  if (!aContext || !aCallback) {
+    return false;
+  }
+
+  os_unfair_lock_lock(&sCaptureLock);
+  sCaptureContext = aContext;
+  sCaptureCallback = aCallback;
+  sStopping = NO;
+  sLoggedFirstBuffer = NO;
+  sLoggedRenderError = NO;
+  sLevelBufferCount = 0;
+  sLevelFrameCount = 0;
+  sLevelPeak = 0;
+  sLevelSumSquares = 0.0;
+  os_unfair_lock_unlock(&sCaptureLock);
+
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (!IsCurrentCapture(aContext)) {
+      return;
+    }
+
+    AVAudioSession* session = AVAudioSession.sharedInstance;
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    switch (session.recordPermission) {
+      case AVAudioSessionRecordPermissionGranted:
+        StartRemoteIOOnMainThread(aContext);
+        break;
+      case AVAudioSessionRecordPermissionDenied:
+        NSLog(@"[GeminiGecko][Mic] microphone permission denied");
+        break;
+      case AVAudioSessionRecordPermissionUndetermined:
+        NSLog(@"[GeminiGecko][Mic] requesting microphone permission");
+        [session requestRecordPermission:^(BOOL granted) {
+          dispatch_async(dispatch_get_main_queue(), ^{
+            NSLog(@"[GeminiGecko][Mic] microphone permission result=%d",
+                  granted ? 1 : 0);
+            if (granted && IsCurrentCapture(aContext)) {
+              StartRemoteIOOnMainThread(aContext);
+            }
+          });
+        }];
+        break;
+      default:
+        break;
+    }
+#pragma clang diagnostic pop
+  });
+  return true;
+}
+
+void StopUIKitAudioCapture(void* aContext) {
+  bool shouldStop = false;
+  os_unfair_lock_lock(&sCaptureLock);
+  if (sCaptureContext == aContext) {
+    sCaptureContext = nullptr;
+    sCaptureCallback = nullptr;
+    shouldStop = true;
+  }
+  os_unfair_lock_unlock(&sCaptureLock);
+
+  if (shouldStop) {
+    // MediaEngineFakeAudioSource::Stop() may be followed immediately by
+    // destruction of aContext. Quiesce RemoteIO before returning so an
+    // already-running callback cannot call back into a freed source object.
+    if ([NSThread isMainThread]) {
+      StopRemoteIOOnMainThread();
+    } else {
+      dispatch_sync(dispatch_get_main_queue(), ^{
+        StopRemoteIOOnMainThread();
+      });
+    }
+  }
+}
+
+}  // namespace mozilla::widget
