@@ -80,10 +80,15 @@ using GetCurrentThreadStackLimitsFn = void(WINAPI*)(PULONG_PTR LowLimit,
 #  define HAVE_SCHED_SETAFFINITY
 #endif
 
+#if defined(XP_MACOSX) || defined(XP_IOS)
+#  define MOZ_HAS_DARWIN_THREAD_QOS
+#  include <pthread/qos.h>
+#  include <sys/qos.h>
