+static Modifiers GeckoModifiersForWebEventFlags(WebEventFlags aFlags) {
+  Modifiers modifiers = MODIFIER_NONE;
+  if (aFlags & WebEventFlagMaskLeftCapsLockKey) {
+    modifiers |= MODIFIER_CAPSLOCK;
+  }
+  if (aFlags & WebEventFlagMaskShiftKey) {
+    modifiers |= MODIFIER_SHIFT;
+  }
+  if (aFlags & WebEventFlagMaskControlKey) {
+    modifiers |= MODIFIER_CONTROL;
+  }
+  if (aFlags & WebEventFlagMaskOptionKey) {
+    modifiers |= MODIFIER_ALT;
+  }
+  if (aFlags & WebEventFlagMaskCommandKey) {
+    modifiers |= MODIFIER_META;
+  }
+  return modifiers;
+}
+
+static TimeStamp GeckoTimeStampForWebEvent(CFTimeInterval aTimestamp) {
+  NSTimeInterval age = NSProcessInfo.processInfo.systemUptime - aTimestamp;
+  return TimeStamp::Now() - TimeDuration::FromSeconds(age);
+}
+
+static CodeNameIndex ComputeCodeNameIndex(uint16_t aKeyCode) {
+  if (aKeyCode >= kVK0 && aKeyCode <= kVK9) {
+    return static_cast<CodeNameIndex>(CODE_NAME_INDEX_Digit0 +
+                                      (aKeyCode - kVK0));
+  }
+  if (aKeyCode >= kVKA && aKeyCode <= kVKZ) {
+    return static_cast<CodeNameIndex>(CODE_NAME_INDEX_KeyA + (aKeyCode - kVKA));
+  }
+  if (aKeyCode >= kVKNumpad0 && aKeyCode <= kVKNumpad9) {
+    return static_cast<CodeNameIndex>(CODE_NAME_INDEX_Numpad0 +
+                                      (aKeyCode - kVKNumpad0));
+  }
+  if (aKeyCode >= kVKF1 && aKeyCode <= kVKF20) {
+    return static_cast<CodeNameIndex>(CODE_NAME_INDEX_F1 + (aKeyCode - kVKF1));
+  }
+
+  switch (aKeyCode) {
+    case kVKOEM3:
+      return CODE_NAME_INDEX_Backquote;
+    case kVKOEM5:
+      return CODE_NAME_INDEX_Backslash;
+    case kVKBack:
+      return CODE_NAME_INDEX_Backspace;
+    case kVKOEM4:
+      return CODE_NAME_INDEX_BracketLeft;
+    case kVKOEM6:
+      return CODE_NAME_INDEX_BracketRight;
+    case kVKOEMComma:
+      return CODE_NAME_INDEX_Comma;
+    case kVKOEMPlus:
+      return CODE_NAME_INDEX_Equal;
+    case kVKOEM102:
+      return CODE_NAME_INDEX_IntlBackslash;
+    case kVKOEMMinus:
+      return CODE_NAME_INDEX_Minus;
+    case kVKOEMPeriod:
+      return CODE_NAME_INDEX_Period;
+    case kVKOEM7:
+      return CODE_NAME_INDEX_Quote;
+    case kVKOEM1:
+      return CODE_NAME_INDEX_Semicolon;
+    case kVKOEM2:
+      return CODE_NAME_INDEX_Slash;
+    case kVKLMenu:
+      return CODE_NAME_INDEX_AltLeft;
+    case kVKRMenu:
+      return CODE_NAME_INDEX_AltRight;
+    case kVKCapital:
+      return CODE_NAME_INDEX_CapsLock;
+    case kVKLControl:
+      return CODE_NAME_INDEX_ControlLeft;
+    case kVKRControl:
+      return CODE_NAME_INDEX_ControlRight;
+    case kVKReturn:
+      return CODE_NAME_INDEX_Enter;
+    case kVKLWin:
+      return CODE_NAME_INDEX_MetaLeft;
+    case kVKApps:
+    case kVKRWin:
+      return CODE_NAME_INDEX_MetaRight;
+    case kVKLShift:
+      return CODE_NAME_INDEX_ShiftLeft;
+    case kVKRShift:
+      return CODE_NAME_INDEX_ShiftRight;
+    case kVKSpace:
+      return CODE_NAME_INDEX_Space;
+    case kVKTab:
+      return CODE_NAME_INDEX_Tab;
+    case kVKKana:
+      return CODE_NAME_INDEX_KanaMode;
+    case kVKDelete:
+      return CODE_NAME_INDEX_Delete;
+    case kVKEnd:
+      return CODE_NAME_INDEX_End;
+    case kVKHelp:
+      return CODE_NAME_INDEX_Help;
+    case kVKHome:
+      return CODE_NAME_INDEX_Home;
+    case kVKInsert:
+      return CODE_NAME_INDEX_Insert;
+    case kVKNext:
+      return CODE_NAME_INDEX_PageDown;
+    case kVKPrior:
+      return CODE_NAME_INDEX_PageUp;
+    case kVKDown:
+      return CODE_NAME_INDEX_ArrowDown;
+    case kVKLeft:
+      return CODE_NAME_INDEX_ArrowLeft;
+    case kVKRight:
+      return CODE_NAME_INDEX_ArrowRight;
+    case kVKUp:
+      return CODE_NAME_INDEX_ArrowUp;
+    case kVKNumLock:
+      return CODE_NAME_INDEX_NumLock;
+    case kVKAdd:
+      return CODE_NAME_INDEX_NumpadAdd;
+    case kVKSeparator:
+      return CODE_NAME_INDEX_NumpadComma;
+    case kVKDecimal:
+      return CODE_NAME_INDEX_NumpadDecimal;
+    case kVKDivide:
+      return CODE_NAME_INDEX_NumpadDivide;
+    case kVKClear:
+      return CODE_NAME_INDEX_NumpadEqual;
+    case kVKMultiply:
+      return CODE_NAME_INDEX_NumpadMultiply;
+    case kVKSubtract:
+      return CODE_NAME_INDEX_NumpadSubtract;
+    case kVKEscape:
+      return CODE_NAME_INDEX_Escape;
+    case kVKVolumeDown:
+      return CODE_NAME_INDEX_VolumeDown;
+    case kVKVolumeMute:
+      return CODE_NAME_INDEX_VolumeMute;
+    case kVKVolumeUp:
+      return CODE_NAME_INDEX_VolumeUp;
+    default:
+      return CODE_NAME_INDEX_UNKNOWN;
+  }
+}
+
+static KeyNameIndex ComputeSpecialKeyNameIndex(uint16_t aKeyCode) {
+  if (aKeyCode >= kVKF1 && aKeyCode <= kVKF20) {
+    return static_cast<KeyNameIndex>(KEY_NAME_INDEX_F1 + (aKeyCode - kVKF1));
+  }
+
+  switch (aKeyCode) {
+    case kVKBack:
+      return KEY_NAME_INDEX_Backspace;
+    case kVKTab:
+      return KEY_NAME_INDEX_Tab;
+    case kVKClear:
+      return KEY_NAME_INDEX_Clear;
+    case kVKReturn:
+      return KEY_NAME_INDEX_Enter;
+    case kVKShift:
+    case kVKLShift:
+    case kVKRShift:
+      return KEY_NAME_INDEX_Shift;
+    case kVKControl:
+    case kVKLControl:
+    case kVKRControl:
+      return KEY_NAME_INDEX_Control;
+    case kVKMenu:
+    case kVKLMenu:
+    case kVKRMenu:
+      return KEY_NAME_INDEX_Alt;
+    case kVKCapital:
+      return KEY_NAME_INDEX_CapsLock;
+    case kVKEscape:
+      return KEY_NAME_INDEX_Escape;
+    case kVKPrior:
+      return KEY_NAME_INDEX_PageUp;
+    case kVKNext:
+      return KEY_NAME_INDEX_PageDown;
+    case kVKEnd:
+      return KEY_NAME_INDEX_End;
+    case kVKHome:
+      return KEY_NAME_INDEX_Home;
+    case kVKLeft:
+      return KEY_NAME_INDEX_ArrowLeft;
+    case kVKUp:
+      return KEY_NAME_INDEX_ArrowUp;
+    case kVKRight:
+      return KEY_NAME_INDEX_ArrowRight;
+    case kVKDown:
+      return KEY_NAME_INDEX_ArrowDown;
+    case kVKInsert:
+      return KEY_NAME_INDEX_Insert;
+    case kVKDelete:
+      return KEY_NAME_INDEX_Delete;
+    case kVKLWin:
+    case kVKRWin:
+    case kVKApps:
+      return KEY_NAME_INDEX_Meta;
+    case kVKNumLock:
+      return KEY_NAME_INDEX_NumLock;
+    case kVKKana:
+      return KEY_NAME_INDEX_KanaMode;
+    case kVKHelp:
+      return KEY_NAME_INDEX_Help;
+    case kVKVolumeDown:
+      return KEY_NAME_INDEX_AudioVolumeDown;
+    case kVKVolumeMute:
+      return KEY_NAME_INDEX_AudioVolumeMute;
+    case kVKVolumeUp:
+      return KEY_NAME_INDEX_AudioVolumeUp;
+    default:
+      return KEY_NAME_INDEX_Unidentified;
+  }
+}
+
+static bool IsWritingSystemCode(CodeNameIndex aCodeNameIndex) {
+  return (aCodeNameIndex >= CODE_NAME_INDEX_Backquote &&
+          aCodeNameIndex <= CODE_NAME_INDEX_Slash) ||
+         (aCodeNameIndex >= CODE_NAME_INDEX_KeyA &&
+          aCodeNameIndex <= CODE_NAME_INDEX_KeyZ) ||
+         aCodeNameIndex == CODE_NAME_INDEX_Space;
+}
+
+static uint32_t ComputeLegacyKeyCode(KeyNameIndex aKeyNameIndex,
+                                     CodeNameIndex aCodeNameIndex,
+                                     const nsAString& aKeyValue,
+                                     uint16_t aNativeKeyCode) {
+  if (aKeyNameIndex != KEY_NAME_INDEX_USE_STRING) {
+    uint32_t keyCode =
+        WidgetKeyboardEvent::ComputeKeyCodeFromKeyNameIndex(aKeyNameIndex);
+    return keyCode ? keyCode : aNativeKeyCode;
+  }
+  if (!aKeyValue.IsEmpty()) {
+    uint32_t keyCode = WidgetUtils::ComputeKeyCodeFromChar(aKeyValue[0]);
+    if (keyCode) {
+      return keyCode;
+    }
+  }
+  uint32_t keyCode =
+      WidgetKeyboardEvent::GetFallbackKeyCodeOfPunctuationKey(aCodeNameIndex);
+  return keyCode ? keyCode : aNativeKeyCode;
+}
+
+static bool IsModifierKeyName(KeyNameIndex aKeyNameIndex) {
+  return aKeyNameIndex == KEY_NAME_INDEX_Alt ||
+         aKeyNameIndex == KEY_NAME_INDEX_CapsLock ||
+         aKeyNameIndex == KEY_NAME_INDEX_Control ||
+         aKeyNameIndex == KEY_NAME_INDEX_Meta ||
+         aKeyNameIndex == KEY_NAME_INDEX_Shift;
+}
+
+static bool IsRepeatableSpecialKey(WebEvent* aEvent) {
+  const KeyNameIndex keyName = ComputeSpecialKeyNameIndex(aEvent.keyCode);
+  return aEvent.keyCode == kVKSpace ||
+         (keyName != KEY_NAME_INDEX_Unidentified &&
+          !IsModifierKeyName(keyName));
+}
+
+static CFTimeInterval PhysicalKeyRepeatInterval() {
+  using KeyRepeatIntervalFunction = double (*)();
+  static KeyRepeatIntervalFunction keyRepeatInterval =
+      reinterpret_cast<KeyRepeatIntervalFunction>(
+          dlsym(RTLD_DEFAULT, "_AXSKeyRepeatInterval"));
+  MOZ_RELEASE_ASSERT(keyRepeatInterval);
+  return keyRepeatInterval();
+}
+
+}  // namespace
+
+struct GeckoKeyboardSupport::HeldKey {
+  uint16_t mNativeKeyCode = 0;
+  uint32_t mKeyCode = 0;
+  KeyNameIndex mKeyNameIndex = KEY_NAME_INDEX_Unidentified;
+  CodeNameIndex mCodeNameIndex = CODE_NAME_INDEX_UNKNOWN;
+  nsString mKeyValue;
+  uint32_t mLocation = eKeyLocationStandard;
+};
+
+GeckoKeyboardSupport::GeckoKeyboardSupport(TextInputHandler* aHandler)
+    : mHandler(aHandler) {}
+
+GeckoKeyboardSupport::~GeckoKeyboardSupport() { StopKeyRepeat(); }
+
+void GeckoKeyboardSupport::InitKeyEvent(WebEvent* aNativeEvent,
+                                        WidgetKeyboardEvent& aEvent,
+                                        uint32_t aUniqueId,
+                                        bool aProcessedByIME,
+                                        const nsAString* aInsertString,
+                                        bool aForceRepeat) const {
+  aEvent.mModifiers =
+      GeckoModifiersForWebEventFlags(aNativeEvent.modifierFlags);
+  aEvent.mCodeNameIndex = ComputeCodeNameIndex(aNativeEvent.keyCode);
+  aEvent.mLocation =
+      WidgetKeyboardEvent::ComputeLocationFromCodeValue(aEvent.mCodeNameIndex);
+  aEvent.mIsRepeat = aEvent.mMessage != eKeyUp &&
+                     (aForceRepeat || aNativeEvent.isKeyRepeating);
+  aEvent.mTimeStamp = aForceRepeat
+                          ? TimeStamp::Now()
+                          : GeckoTimeStampForWebEvent(aNativeEvent.timestamp);
+  aEvent.mUniqueId = aUniqueId;
+
+  if (aProcessedByIME) {
+    aEvent.mKeyNameIndex = KEY_NAME_INDEX_Process;
+    aEvent.mKeyCode = NS_VK_PROCESSKEY;
+    return;
+  }
+
+  aEvent.mKeyNameIndex = ComputeSpecialKeyNameIndex(aNativeEvent.keyCode);
+  if (aEvent.mKeyNameIndex == KEY_NAME_INDEX_Unidentified) {
+    NSString* nativeCharacters = aEvent.IsControl()
+                                     ? aNativeEvent.charactersIgnoringModifiers
+                                     : aNativeEvent.characters;
+    nsString characters;
+    if (aInsertString) {
+      characters = *aInsertString;
+    } else {
+      CopyNSStringToXPCOMString(nativeCharacters ?: @"", characters);
+    }
+    if (!characters.IsEmpty()) {
+      aEvent.mKeyNameIndex = KEY_NAME_INDEX_USE_STRING;
+      aEvent.mKeyValue = characters;
+      if (aEvent.mKeyValue[0] < 0x20 || aEvent.mKeyValue[0] == 0x7F) {
+        CopyNSStringToXPCOMString(
+            aNativeEvent.charactersIgnoringModifiers ?: @"", aEvent.mKeyValue);
+      }
+    } else if (IsWritingSystemCode(aEvent.mCodeNameIndex)) {
+      aEvent.mKeyNameIndex = KEY_NAME_INDEX_Dead;
+    }
+  }
+  aEvent.mKeyCode =
+      ComputeLegacyKeyCode(aEvent.mKeyNameIndex, aEvent.mCodeNameIndex,
+                           aEvent.mKeyValue, aNativeEvent.keyCode);
+}
+
+Modifiers GeckoKeyboardSupport::CurrentModifiers() const {
+  return mCurrentModifiers;
+}
+
+uint32_t GeckoKeyboardSupport::NextUniqueId() { return ++mNextEventId; }
+
+bool GeckoKeyboardSupport::Destroyed() const { return mHandler->Destroyed(); }
+
+void GeckoKeyboardSupport::RememberKeyDown(WebEvent* aEvent) {
+  if (aEvent.isKeyRepeating) {
+    return;
+  }
+  for (const auto& heldKey : mHeldKeys) {
+    if (heldKey->mNativeKeyCode == aEvent.keyCode) {
+      return;
+    }
+  }
+
+  WidgetKeyboardEvent keydownEvent(true, eKeyDown, mHandler->mWidget);
+  InitKeyEvent(aEvent, keydownEvent, 0);
+  auto heldKey = MakeUnique<HeldKey>();
+  heldKey->mNativeKeyCode = aEvent.keyCode;
+  heldKey->mKeyCode = keydownEvent.mKeyCode;
+  heldKey->mKeyNameIndex = keydownEvent.mKeyNameIndex;
+  heldKey->mCodeNameIndex = keydownEvent.mCodeNameIndex;
+  heldKey->mKeyValue = keydownEvent.mKeyValue;
+  heldKey->mLocation = keydownEvent.mLocation;
+  mHeldKeys.AppendElement(std::move(heldKey));
+}
+
+void GeckoKeyboardSupport::ForgetKeyUp(WebEvent* aEvent) {
+  mHeldKeys.RemoveElementsBy([aEvent](const UniquePtr<HeldKey>& aHeldKey) {
+    return aHeldKey->mNativeKeyCode == aEvent.keyCode;
+  });
+}
+
+void GeckoKeyboardSupport::StartKeyRepeat(WebEvent* aEvent) {
+  if (mKeyRepeatTimer || !IsRepeatableSpecialKey(aEvent)) {
+    return;
+  }
+
+  const CFTimeInterval interval = PhysicalKeyRepeatInterval();
+  if (interval <= 0) {
+    return;
+  }
+
+  mRepeatingEvent = [aEvent retain];
+  CFRunLoopTimerContext context = {0, this, nullptr, nullptr, nullptr};
+  mKeyRepeatTimer = CFRunLoopTimerCreate(
+      kCFAllocatorDefault, CFAbsoluteTimeGetCurrent() + interval, interval, 0,
+      0, KeyRepeatTimerFired, &context);
+  CFRunLoopAddTimer(CFRunLoopGetMain(), mKeyRepeatTimer, kCFRunLoopCommonModes);
+}
+
+void GeckoKeyboardSupport::StopKeyRepeat() {
+  if (mKeyRepeatTimer) {
+    CFRunLoopTimerInvalidate(mKeyRepeatTimer);
+    CFRelease(mKeyRepeatTimer);
+    mKeyRepeatTimer = nullptr;
+  }
+  [mRepeatingEvent release];
+  mRepeatingEvent = nil;
+}
+
+void GeckoKeyboardSupport::KeyRepeatTimerFired(CFRunLoopTimerRef, void* aInfo) {
+  static_cast<GeckoKeyboardSupport*>(aInfo)->RepeatKey();
+}
+
+void GeckoKeyboardSupport::RepeatKey() {
+  if (Destroyed() || !mRepeatingEvent) {
+    StopKeyRepeat();
+    return;
+  }
+
+  bool isHeld = false;
+  for (const auto& heldKey : mHeldKeys) {
+    if (heldKey->mNativeKeyCode == mRepeatingEvent.keyCode) {
+      isHeld = true;
+      break;
+    }
+  }
+  if (!isHeld) {
+    StopKeyRepeat();
+    return;
+  }
+
+  RefPtr<TextInputHandler> kungFuDeathGrip(mHandler);
+  mHandler->DispatchPhysicalKeyDown(mRepeatingEvent, true, false);
+}
+
+bool GeckoKeyboardSupport::DispatchKeyUp(WebEvent* aEvent) {
+  if (Destroyed()) {
+    return false;
+  }
+  nsresult rv = mHandler->mDispatcher->BeginNativeInputTransaction();
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+
+  WidgetKeyboardEvent keyupEvent(true, eKeyUp, mHandler->mWidget);
+  InitKeyEvent(aEvent, keyupEvent, 0);
+  nsEventStatus status = nsEventStatus_eIgnore;
+  return mHandler->mDispatcher->DispatchKeyboardEvent(eKeyUp, keyupEvent,
+                                                      status);
+}
+
+bool GeckoKeyboardSupport::DispatchHeldKeyUp(const HeldKey& aHeldKey,
+                                             Modifiers aModifiers) {
+  if (Destroyed()) {
+    return false;
+  }
+  nsresult rv = mHandler->mDispatcher->BeginNativeInputTransaction();
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+
+  WidgetKeyboardEvent keyupEvent(true, eKeyUp, mHandler->mWidget);
+  keyupEvent.mKeyCode = aHeldKey.mKeyCode;
+  keyupEvent.mKeyNameIndex = aHeldKey.mKeyNameIndex;
+  keyupEvent.mCodeNameIndex = aHeldKey.mCodeNameIndex;
+  keyupEvent.mKeyValue = aHeldKey.mKeyValue;
+  keyupEvent.mModifiers = aModifiers;
+  keyupEvent.mLocation = aHeldKey.mLocation;
+  keyupEvent.mIsRepeat = false;
+  keyupEvent.mTimeStamp = TimeStamp::Now();
+  nsEventStatus status = nsEventStatus_eIgnore;
+  return mHandler->mDispatcher->DispatchKeyboardEvent(eKeyUp, keyupEvent,
+                                                      status);
+}
+
+void GeckoKeyboardSupport::ReleasePhysicalKeys() {
+  StopKeyRepeat();
+  nsTArray<UniquePtr<HeldKey>> heldKeys;
+  heldKeys.SwapElements(mHeldKeys);
+  Modifiers modifiers = mCurrentModifiers;
+  mCurrentModifiers = MODIFIER_NONE;
+  if (heldKeys.IsEmpty() || Destroyed()) {
+    return;
+  }
+
+  for (const auto& heldKey : heldKeys) {
+    if (!IsModifierKeyName(heldKey->mKeyNameIndex)) {
+      DispatchHeldKeyUp(*heldKey, modifiers);
+    }
+  }
+  for (const auto& heldKey : heldKeys) {
+    switch (heldKey->mKeyNameIndex) {
+      case KEY_NAME_INDEX_Alt:
+        modifiers &= ~MODIFIER_ALT;
+        break;
+      case KEY_NAME_INDEX_CapsLock:
+        modifiers &= ~MODIFIER_CAPSLOCK;
+        break;
+      case KEY_NAME_INDEX_Control:
+        modifiers &= ~MODIFIER_CONTROL;
+        break;
+      case KEY_NAME_INDEX_Meta:
+        modifiers &= ~MODIFIER_META;
+        break;
+      case KEY_NAME_INDEX_Shift:
+        modifiers &= ~MODIFIER_SHIFT;
+        break;
+      default:
+        continue;
+    }
+    DispatchHeldKeyUp(*heldKey, modifiers);
+  }
+}
+
+bool GeckoKeyboardSupport::HandleKeyEvent(WebEvent* aEvent) {
+  if (Destroyed() || !aEvent ||
+      (aEvent.type != WebEventKeyDown && aEvent.type != WebEventKeyUp)) {
+    return false;
+  }
+
+  RefPtr<TextInputHandler> kungFuDeathGrip(mHandler);
+  mCurrentModifiers = GeckoModifiersForWebEventFlags(aEvent.modifierFlags);
+  if (aEvent.type == WebEventKeyUp) {
+    if (mRepeatingEvent && mRepeatingEvent.keyCode == aEvent.keyCode) {
+      StopKeyRepeat();
+    }
+    bool dispatched = DispatchKeyUp(aEvent);
+    ForgetKeyUp(aEvent);
+    return dispatched;
+  }
+
+  const bool modifierFlagsChanged =
+      aEvent.keyboardFlags & WebEventKeyboardInputModifierFlagsChanged;
+  if (modifierFlagsChanged && !aEvent.isKeyRepeating) {
+    KeyNameIndex keyName = ComputeSpecialKeyNameIndex(aEvent.keyCode);
+    for (const auto& heldKey : mHeldKeys) {
+      if (heldKey->mNativeKeyCode == aEvent.keyCode &&
+          IsModifierKeyName(keyName)) {
+        return true;
+      }
+    }
+  }
+
+  if (!aEvent.isKeyRepeating &&
+      !IsModifierKeyName(ComputeSpecialKeyNameIndex(aEvent.keyCode))) {
+    StopKeyRepeat();
+  } else if (aEvent.isKeyRepeating && mRepeatingEvent &&
+             mRepeatingEvent.keyCode == aEvent.keyCode) {
+    return true;
+  }
+
+  RememberKeyDown(aEvent);
+  bool handled = mHandler->DispatchPhysicalKeyDown(aEvent, false, true);
+  if (aEvent.isKeyRepeating && handled && !Destroyed()) {
+    StartKeyRepeat(aEvent);
+  }
+  return handled;
+}
+
+void GeckoKeyboardSupport::HandleModifierFlagsChanged(
+    UIKeyModifierFlags aOldFlags, UIKeyModifierFlags aNewFlags) {
+  struct ModifierTransition {
+    UIKeyModifierFlags mFlag;
+    uint16_t mNativeKeyCode;
+    KeyNameIndex mKeyNameIndex;
+    CodeNameIndex mCodeNameIndex;
+  };
+  constexpr ModifierTransition transitions[] = {
+      {UIKeyModifierShift, kVKLShift, KEY_NAME_INDEX_Shift,
+       CODE_NAME_INDEX_ShiftLeft},
+      {UIKeyModifierAlphaShift, kVKCapital, KEY_NAME_INDEX_CapsLock,
+       CODE_NAME_INDEX_CapsLock},
+  };
+
+  auto geckoModifiers = [](UIKeyModifierFlags aFlags) {
+    Modifiers modifiers = MODIFIER_NONE;
+    if (aFlags & UIKeyModifierAlphaShift) {
+      modifiers |= MODIFIER_CAPSLOCK;
+    }
+    if (aFlags & UIKeyModifierShift) {
+      modifiers |= MODIFIER_SHIFT;
+    }
+    if (aFlags & UIKeyModifierControl) {
+      modifiers |= MODIFIER_CONTROL;
+    }
+    if (aFlags & UIKeyModifierAlternate) {
+      modifiers |= MODIFIER_ALT;
+    }
+    if (aFlags & UIKeyModifierCommand) {
+      modifiers |= MODIFIER_META;
+    }
+    return modifiers;
+  };
+
+  mCurrentModifiers = geckoModifiers(aNewFlags);
+  for (const auto& transition : transitions) {
+    bool wasDown = aOldFlags & transition.mFlag;
+    bool isDown = aNewFlags & transition.mFlag;
+    if (wasDown == isDown || Destroyed()) {
+      continue;
+    }
+
+    if (isDown) {
+      bool alreadyHeld = false;
+      for (const auto& heldKey : mHeldKeys) {
+        alreadyHeld |= heldKey->mNativeKeyCode == transition.mNativeKeyCode;
+      }
+      if (alreadyHeld) {
+        continue;
+      }
+      auto heldKey = MakeUnique<HeldKey>();
+      heldKey->mNativeKeyCode = transition.mNativeKeyCode;
+      heldKey->mKeyCode = WidgetKeyboardEvent::ComputeKeyCodeFromKeyNameIndex(
+          transition.mKeyNameIndex);
+      heldKey->mKeyNameIndex = transition.mKeyNameIndex;
+      heldKey->mCodeNameIndex = transition.mCodeNameIndex;
+      heldKey->mLocation = WidgetKeyboardEvent::ComputeLocationFromCodeValue(
+          heldKey->mCodeNameIndex);
+
+      WidgetKeyboardEvent keydownEvent(true, eKeyDown, mHandler->mWidget);
+      keydownEvent.mKeyCode = heldKey->mKeyCode;
+      keydownEvent.mKeyNameIndex = heldKey->mKeyNameIndex;
+      keydownEvent.mCodeNameIndex = heldKey->mCodeNameIndex;
+      keydownEvent.mModifiers = mCurrentModifiers;
+      keydownEvent.mLocation = heldKey->mLocation;
+      keydownEvent.mTimeStamp = TimeStamp::Now();
+      keydownEvent.mUniqueId = NextUniqueId();
+      nsEventStatus status = nsEventStatus_eIgnore;
+      if (NS_SUCCEEDED(mHandler->mDispatcher->BeginNativeInputTransaction())) {
+        mHeldKeys.AppendElement(std::move(heldKey));
+        mHandler->mDispatcher->DispatchKeyboardEvent(eKeyDown, keydownEvent,
+                                                     status);
+      }
+      continue;
+    }
+
+    for (size_t index = 0; index < mHeldKeys.Length(); ++index) {
+      if (mHeldKeys[index]->mNativeKeyCode == transition.mNativeKeyCode) {
+        UniquePtr<HeldKey> heldKey = std::move(mHeldKeys[index]);
+        mHeldKeys.RemoveElementAt(index);
+        DispatchHeldKeyUp(*heldKey, mCurrentModifiers);
+        break;
+      }
+    }
+  }
+}
