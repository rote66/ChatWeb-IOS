diff --git a/hal/uikit/UIKitScreenConfiguration.mm b/hal/uikit/UIKitScreenConfiguration.mm
new file mode 100644
index 0000000000000000000000000000000000000000..227774cb96c7263b5a0f3a76d442265ee536e5a8
--- /dev/null
+++ b/hal/uikit/UIKitScreenConfiguration.mm
@@ -0,0 +1,111 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* This source code is introduced during the work of an iOS 13+ browser
+ * https://github.com/minh-ton/reynard-browser in Feb 2026. */
+
+#include "HalImpl.h"
+
+#include "mozilla/widget/GeckoViewSupport.h"
+#include "mozilla/widget/Screen.h"
+#include "mozilla/widget/ScreenManager.h"
+
+namespace mozilla::hal_impl {
+
+static bool IsSupportedScreenOrientation(
+    const hal::ScreenOrientation& aOrientation) {
+  static constexpr hal::ScreenOrientation kSupportedOrientations[] = {
+      hal::ScreenOrientation::PortraitPrimary,
+      hal::ScreenOrientation::PortraitSecondary,
+      hal::ScreenOrientation::PortraitPrimary |
+          hal::ScreenOrientation::PortraitSecondary,
+      hal::ScreenOrientation::LandscapePrimary,
+      hal::ScreenOrientation::LandscapeSecondary,
+      hal::ScreenOrientation::LandscapePrimary |
+          hal::ScreenOrientation::LandscapeSecondary,
+      hal::ScreenOrientation::PortraitPrimary |
+          hal::ScreenOrientation::PortraitSecondary |
+          hal::ScreenOrientation::LandscapePrimary |
+          hal::ScreenOrientation::LandscapeSecondary,
+      hal::ScreenOrientation::Default,
+  };
+
+  for (const auto supportedOrientation : kSupportedOrientations) {
+    if (aOrientation == supportedOrientation) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static UIInterfaceOrientationMask ToInterfaceOrientationMask(
+    const hal::ScreenOrientation& aOrientation) {
+  UIInterfaceOrientationMask orientationMask = 0;
+
+  if (aOrientation & hal::ScreenOrientation::PortraitPrimary) {
+    orientationMask |= UIInterfaceOrientationMaskPortrait;
+  }
+  if (aOrientation & hal::ScreenOrientation::PortraitSecondary) {
+    orientationMask |= UIInterfaceOrientationMaskPortraitUpsideDown;
+  }
+  if (aOrientation & hal::ScreenOrientation::LandscapePrimary) {
+    orientationMask |= UIInterfaceOrientationMaskLandscapeRight;
+  }
+  if (aOrientation & hal::ScreenOrientation::LandscapeSecondary) {
+    orientationMask |= UIInterfaceOrientationMaskLandscapeLeft;
+  }
+
+  return orientationMask;
+}
+
+RefPtr<GenericNonExclusivePromise> LockScreenOrientation(
+    const hal::ScreenOrientation& aOrientation) {
+  if (!IsSupportedScreenOrientation(aOrientation)) {
+    NS_WARNING("Unsupported screen orientation type");
+    return GenericNonExclusivePromise::CreateAndReject(
+        NS_ERROR_DOM_NOT_SUPPORTED_ERR, __func__);
+  }
+
+  id<SwiftGeckoViewRuntime> runtime = widget::GetSwiftRuntime();
+  if (!runtime) {
+    return GenericNonExclusivePromise::CreateAndReject(NS_ERROR_DOM_ABORT_ERR,
+                                                       __func__);
+  }
+
+  hal::ScreenOrientation orientation = aOrientation;
+  if (orientation == hal::ScreenOrientation::Default) {
+    RefPtr<widget::Screen> screen =
+        widget::ScreenManager::GetSingleton().GetPrimaryScreen();
+    orientation = screen->GetDefaultOrientationType();
+  }
+
+  UIInterfaceOrientationMask orientationMask =
+      ToInterfaceOrientationMask(orientation);
+  RefPtr<GenericNonExclusivePromise::Private> promise =
+      new GenericNonExclusivePromise::Private(__func__);
+  [runtime lockScreenOrientation:orientationMask
+                      completion:^(GeckoOrientationLockResult result) {
+                        switch (result) {
+                          case GeckoOrientationLockResultSuccess:
+                            promise->Resolve(true, __func__);
+                            break;
+                          case GeckoOrientationLockResultRejected:
+                            promise->Reject(NS_ERROR_DOM_ABORT_ERR, __func__);
+                            break;
+                          case GeckoOrientationLockResultNotSupported:
+                            promise->Reject(NS_ERROR_DOM_NOT_SUPPORTED_ERR,
+                                            __func__);
+                            break;
+                        }
+                      }];
+  return promise;
+}
+
+void UnlockScreenOrientation() {
+  if (id<SwiftGeckoViewRuntime> runtime = widget::GetSwiftRuntime()) {
+    [runtime unlockScreenOrientation];
+  }
+}
+
+}  // namespace mozilla::hal_impl
diff --git a/hal/uikit/UIKitSensor.mm b/hal/uikit/UIKitSensor.mm
new file mode 100644
index 0000000000000000000000000000000000000000..71d020cf693f5a4a326f5dbc1fbf832134fc7c42
--- /dev/null
+++ b/hal/uikit/UIKitSensor.mm
@@ -0,0 +1,170 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* This source code is introduced during the work of an iOS 13+ browser
+ * https://github.com/minh-ton/reynard-browser in Feb 2026. */
+
+#include "mozilla/Hal.h"
+#include "mozilla/HalSensor.h"
+
+#import <CoreMotion/CoreMotion.h>
+
+#include <cmath>
+
+using namespace mozilla::hal;
+
+namespace mozilla::hal_impl {
+
+static constexpr double kMeanGravity = 9.80665;
+static constexpr double kRadToDeg = 180.0 / M_PI;
+static constexpr NSTimeInterval kSensorUpdateInterval = 1.0 / 60.0;
+static constexpr CMAttitudeReferenceFrame kAttitudeReferenceFrame =
+    CMAttitudeReferenceFrameXMagneticNorthZVertical;
+
+static CMMotionManager* sMotionManager = nil;
+static bool sActiveSensors[NUM_SENSOR_TYPE];
+
+static bool IsCoreMotionSensor(SensorType aSensor) {
+  switch (aSensor) {
+    case SENSOR_ACCELERATION:
+    case SENSOR_LINEAR_ACCELERATION:
+    case SENSOR_GYROSCOPE:
+    case SENSOR_ROTATION_VECTOR:
+      return true;
+    default:
+      return false;
+  }
+}
+
+static bool HasActiveCoreMotionSensor() {
+  for (int i = 0; i < NUM_SENSOR_TYPE; i++) {
+    if (sActiveSensors[i] && IsCoreMotionSensor(static_cast<SensorType>(i))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static void NotifySensor(SensorType aSensor, const nsTArray<float>& aValues) {
+  hal::SensorData data(aSensor, PR_Now(), aValues);
+  hal::NotifySensorChange(data);
+}
+
+static void AppendAcceleration(nsTArray<float>& aValues,
+                               const CMAcceleration& aAcceleration) {
+  aValues.AppendElement(aAcceleration.x * kMeanGravity);
+  aValues.AppendElement(aAcceleration.y * kMeanGravity);
+  aValues.AppendElement(aAcceleration.z * kMeanGravity);
+}
+
+static void MotionUpdateHandler(CMDeviceMotion* aMotion, NSError* aError) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  if (aError || !aMotion) {
+    return;
+  }
+
+  if (sActiveSensors[SENSOR_ROTATION_VECTOR]) {
+    CMQuaternion quaternion = aMotion.attitude.quaternion;
+    AutoTArray<float, 4> values;
+    values.AppendElement(quaternion.x);
+    values.AppendElement(quaternion.y);
+    values.AppendElement(quaternion.z);
+    values.AppendElement(quaternion.w);
+    NotifySensor(SENSOR_ROTATION_VECTOR, values);
+  }
+
+  if (sActiveSensors[SENSOR_ACCELERATION]) {
+    CMAcceleration acceleration = aMotion.userAcceleration;
+    acceleration.x += aMotion.gravity.x;
+    acceleration.y += aMotion.gravity.y;
+    acceleration.z += aMotion.gravity.z;
+
+    AutoTArray<float, 3> values;
+    AppendAcceleration(values, acceleration);
+    NotifySensor(SENSOR_ACCELERATION, values);
+  }
+
+  if (sActiveSensors[SENSOR_LINEAR_ACCELERATION]) {
+    AutoTArray<float, 3> values;
+    AppendAcceleration(values, aMotion.userAcceleration);
+    NotifySensor(SENSOR_LINEAR_ACCELERATION, values);
+  }
+
+  if (sActiveSensors[SENSOR_GYROSCOPE]) {
+    CMRotationRate rotationRate = aMotion.rotationRate;
+    AutoTArray<float, 3> values;
+    values.AppendElement(rotationRate.x * kRadToDeg);
+    values.AppendElement(rotationRate.y * kRadToDeg);
+    values.AppendElement(rotationRate.z * kRadToDeg);
+    NotifySensor(SENSOR_GYROSCOPE, values);
+  }
+}
+
+static void StartMotionUpdates() {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  if (!sMotionManager) {
+    sMotionManager = [[CMMotionManager alloc] init];
+  }
+
+  if (sMotionManager.deviceMotionActive) {
+    return;
+  }
+
+  if (!sMotionManager.deviceMotionAvailable) {
+    return;
+  }
+
+  if (!([CMMotionManager availableAttitudeReferenceFrames] &
+        kAttitudeReferenceFrame)) {
+    return;
+  }
+
+  sMotionManager.deviceMotionUpdateInterval = kSensorUpdateInterval;
+  sMotionManager.showsDeviceMovementDisplay = YES;
+  [sMotionManager
+      startDeviceMotionUpdatesUsingReferenceFrame:kAttitudeReferenceFrame
+                                          toQueue:[NSOperationQueue mainQueue]
+                                      withHandler:^(CMDeviceMotion* motion,
+                                                    NSError* error) {
+                                        MotionUpdateHandler(motion, error);
+                                      }];
+}
+
+static void StopMotionUpdatesIfIdle() {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  if (HasActiveCoreMotionSensor() || !sMotionManager) {
+    return;
+  }
+
+  [sMotionManager stopDeviceMotionUpdates];
+  [sMotionManager release];
+  sMotionManager = nil;
+}
+
+void EnableSensorNotifications(SensorType aSensor) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  if (!IsCoreMotionSensor(aSensor)) {
+    return;
+  }
+
+  sActiveSensors[aSensor] = true;
+  StartMotionUpdates();
+}
+
+void DisableSensorNotifications(SensorType aSensor) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  if (!IsCoreMotionSensor(aSensor)) {
+    return;
+  }
+
+  sActiveSensors[aSensor] = false;
+  StopMotionUpdatesIfIdle();
+}
+
+}  // namespace mozilla::hal_impl
