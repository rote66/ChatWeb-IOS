+  if (currentKeyEvent && aEvent && aEvent->mMessage == eKeyPress &&
+      currentKeyEvent->mUniqueId == aEvent->mUniqueId) {
+    currentKeyEvent->mKeyPressPreventedByContent |=
+        aEvent->DefaultPreventedByContent();
+  }
+}
